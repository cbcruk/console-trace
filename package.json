{
  "name": "console-trace",
  "version": "0.1.0",
  "description": "Async-aware tracing for the browser. Builds a span tree that survives module boundaries and await, with no context argument threading, and renders it as a live overlay plus a console.group replay.",
  "keywords": [
    "async-context",
    "asynccontext",
    "browser",
    "debugging",
    "devtools",
    "logging",
    "observability",
    "tracing"
  ],
  "homepage": "https://github.com/cbcruk/console-trace#readme",
  "bugs": {
    "url": "https://github.com/cbcruk/console-trace/issues"
  },
  "license": "MIT",
  "author": "cbcruk (https://github.com/cbcruk)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cbcruk/console-trace.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./vite-plugin-trace": "./dist/vite-plugin-trace.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config && vp pack"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "bumpp": "^11.1.0",
    "happy-dom": "^20.10.6",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.20"
  },
  "peerDependencies": {
    "@babel/core": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@babel/core": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.9.0"
}
